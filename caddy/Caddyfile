# Local/LAN deployment: Caddy terminates TLS with an internally-signed cert.
# For a public hostname, replace `localhost` with the domain and Caddy will
# fetch real certificates automatically.
localhost {
	tls internal

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Backend API (the /api prefix is stripped before proxying).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Web app (SPA: unknown paths fall back to index.html).
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

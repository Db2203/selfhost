# Copy to .env and adjust. The .env file is gitignored — never commit secrets.

ENVIRONMENT=development

POSTGRES_USER=photonest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=photonest
DATABASE_URL=postgresql+asyncpg://photonest:change-me@postgres:5432/photonest

REDIS_URL=redis://redis:6379/0

# Where derived files (thumbnails, uploads) live inside the containers.
STORAGE_ROOT=/srv/storage

# Host path of your existing photo folder; mounted READ-ONLY into the
# containers at /srv/library. The indexer never modifies or copies originals.
LIBRARY_DIR=~/Pictures

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

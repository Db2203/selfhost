# Copy to .env and adjust. The .env file is gitignored — never commit secrets.

ENVIRONMENT=development

POSTGRES_USER=photonest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=photonest
DATABASE_URL=postgresql+asyncpg://photonest:change-me@postgres:5432/photonest

REDIS_URL=redis://redis:6379/0

# Where derived files (thumbnails, uploads) live: "local" disk or any
# S3-compatible store (MinIO, NAS object storage).
STORAGE_BACKEND=local
STORAGE_ROOT=/srv/storage
# Only used when STORAGE_BACKEND=s3:
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Host path of your existing photo folder; mounted READ-ONLY into the
# containers at /srv/library. The indexer never modifies or copies originals.
LIBRARY_DIR=~/Pictures

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
